{
  "info": {
    "_postman_id": "7f07d9d6-4be2-4a4b-9b6f-3e4c1f8a2c11",
    "name": "MyLibrum API",
    "description": "Collection CRUD completa da API MyLibrum. Configure baseUrl e token nas variáveis da collection. O token deve ser gerado pelo fluxo de autenticação disponível no backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "id", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login - Gerar JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token salvo com sucesso:', json.token);",
                  "}",
                  "else {",
                  "  console.log('Resposta sem token:', json);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Esqueci minha senha - Enviar e-mail",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@gmail.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/esqueci-senha"
          }
        },
        {
          "name": "Redefinir senha com token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN_RECEBIDO_POR_EMAIL\",\n  \"novaSenha\": \"novaSenha123\"\n}"
            },
            "url": "{{baseUrl}}/auth/redefinir-senha"
          }
        }
      ]
    },
    {
      "name": "Autores",
      "item": [
        { "name": "Listar autores", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/autores" } },
        { "name": "Buscar autor por ID", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/autores/{{id}}" } },
        { "name": "Criar autor", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Machado de Assis\",\n  \"nacionalidade\": \"Brasileira\",\n  \"dataNascimento\": \"1839-06-21\",\n  \"biografia\": \"Escritor brasileiro.\"\n}" }, "url": "{{baseUrl}}/api/autores" } },
        { "name": "Atualizar autor", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Machado de Assis Atualizado\",\n  \"nacionalidade\": \"Brasileira\"\n}" }, "url": "{{baseUrl}}/api/autores/{{id}}" } },
